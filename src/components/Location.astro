---
import Button from '../ui/Button.astro';
---

<section id="location" class="location section-padding">
  <div class="container">
    <span class="eyebrow">FIND US</span>
    <h2 class="headline">501 Highland Pike, Covington.</h2>
    
    <div class="location-grid">
      <div class="location-info">
        <div class="info-block">
          <h3 class="info-label">Address</h3>
          <p class="info-value">
            501 Highland Pike<br>
            Covington, KY 41014
          </p>
        </div>
        
        <div class="info-block">
          <h3 class="info-label">Phone</h3>
          <a href="tel:18594147088" class="info-link">(859) 414-7088</a>
        </div>
        
        <div class="info-block">
          <h3 class="info-label">Hours</h3>
          <div class="hours-table">
            <div class="hours-row">
              <span class="day">Mon–Fri</span>
              <span class="time">8 AM – 6 PM</span>
            </div>
            <div class="hours-row">
              <span class="day">Sat</span>
              <span class="time">By appointment</span>
            </div>
            <!-- TODO: Owner to confirm hours -->
            <div class="hours-note">* Hours subject to change</div>
          </div>
        </div>
        
        <div class="info-block">
          <h3 class="info-label">Connect</h3>
          <a 
            href="https://www.facebook.com/DreamPerformance21/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="social-link"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.77,7.46H14.5v-1.9c0-.9.6-1.1,1-1.1h3V.5h-4.33C10.24.5,9.5,3.44,9.5,5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4Z"/>
            </svg>
            Facebook
          </a>
        </div>
        
        <div class="status-pill" id="status-pill">
          <span class="status-dot"></span>
          <span class="status-text">Checking...</span>
        </div>
        
        <Button href="tel:18594147088" variant="primary">
          Call Now
        </Button>
      </div>
      
      <div class="map-container">
        <div class="map-placeholder">
          <span>Loading map...</span>
        </div>
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3084.567891234567!2d-84.5086!3d39.0837!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8841b5c8b3b3b3b3%3A0x1234567890abcdef!2s501%20Highland%20Pike%2C%20Covington%2C%20KY%2041014!5e0!3m2!1sen!2sus!4v1234567890"
          width="100%" 
          height="400" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          title="Map of Dream Performance Vehicle Repair location"
          class="map-iframe"
          onload="this.previousElementSibling.style.display='none'; this.style.opacity='1';"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    background-color: var(--bg-elevated);
  }
  
  .eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  
  .headline {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 3rem;
  }
  
  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  
  .location-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .info-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .info-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }
  
  .info-value {
    font-size: 1rem;
    color: var(--text);
    line-height: 1.6;
  }
  
  .info-link {
    font-size: 1rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  
  .info-link:hover {
    color: var(--accent-hover);
  }
  
  .hours-table {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .hours-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  
  .day {
    color: var(--text-muted);
  }
  
  .time {
    color: var(--text);
  }
  
  .hours-note {
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-top: 0.5rem;
    font-style: italic;
  }
  
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .social-link:hover {
    color: var(--accent);
  }
  
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.375rem 0.75rem;
    width: fit-content;
    font-size: 0.8125rem;
  }
  
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--text-dim);
  }
  
  .status-dot.open {
    background-color: var(--success);
  }
  
  .status-dot.closed {
    background-color: #ef4444;
  }
  
  .status-text {
    color: var(--text-muted);
  }
  
  .map-container {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    min-height: 400px;
  }
  
  .map-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-card);
    color: var(--text-dim);
    font-size: 0.875rem;
    z-index: 1;
  }
  
  .map-iframe {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  
  @media (max-width: 768px) {
    .location-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .map-container {
      min-height: 300px;
    }
  }
</style>

<script>
  const statusPill = document.getElementById('status-pill');
  
  function updateStatus() {
    const now = new Date();
    const day = now.getDay();
    const hours = now.getHours();
    const minutes = now.getMinutes();
    const currentTime = hours * 60 + minutes;
    
    const openTime = 8 * 60;
    const closeTime = 18 * 60;
    
    let isOpen = false;
    let statusText = 'Closed';
    
    if (day >= 1 && day <= 5) {
      if (currentTime >= openTime && currentTime < closeTime) {
        isOpen = true;
        statusText = 'Open now';
      } else if (currentTime < openTime) {
        statusText = `Opens at 8 AM`;
      } else {
        statusText = 'Closed';
      }
    } else if (day === 6) {
      statusText = 'By appointment';
    } else {
      statusText = 'Closed';
    }
    
    if (statusPill) {
      const dot = statusPill.querySelector('.status-dot');
      const text = statusPill.querySelector('.status-text');
      
      if (dot && text) {
        if (isOpen) {
          dot.classList.add('open');
          dot.classList.remove('closed');
        } else {
          dot.classList.remove('open');
          dot.classList.add('closed');
        }
        text.textContent = statusText;
      }
    }
  }
  
  updateStatus();
  setInterval(updateStatus, 60000);
</script>