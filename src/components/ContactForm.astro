---
---

<section id="contact" class="contact section-padding">
  <div class="container">
    <span class="eyebrow">OR SEND A MESSAGE</span>
    <h2 class="headline">Tell us what's going on.</h2>
    
    <p class="form-note">Want a faster answer? Call <a href="tel:18594147088" class="phone-link">(859) 414-7088</a>.</p>
    
    <form class="contact-form" id="contact-form">
      <div class="form-row">
        <div class="form-group">
          <label for="name" class="form-label">Name</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required
            class="form-input"
            autocomplete="name"
          >
        </div>
        
        <div class="form-group">
          <label for="phone" class="form-label">Phone</label>
          <input 
            type="tel" 
            id="phone" 
            name="phone" 
            required
            class="form-input"
            autocomplete="tel"
          >
        </div>
      </div>
      
      <div class="form-group">
        <label for="vehicle" class="form-label">Vehicle (Year/Make/Model)</label>
        <input 
          type="text" 
          id="vehicle" 
          name="vehicle" 
          class="form-input"
          placeholder="e.g. 2019 Honda Civic"
        >
      </div>
      
      <div class="form-group">
        <label for="issue" class="form-label">What's the issue?</label>
        <textarea 
          id="issue" 
          name="issue" 
          rows="4"
          class="form-input form-textarea"
          placeholder="Describe what's happening with your vehicle..."
        ></textarea>
      </div>
      
      <button type="submit" class="submit-btn">
        Send Message
      </button>
      
      <div class="form-success" id="form-success" aria-live="polite">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>We'll call you back within 24 hours.</span>
      </div>
    </form>
  </div>
</section>

<style>
  .contact {
    background-color: var(--bg);
  }
  
  .eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  
  .headline {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  
  .form-note {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
  
  .phone-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  
  .phone-link:hover {
    text-decoration: underline;
  }
  
  .contact-form {
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .form-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
  }
  
  .form-input {
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    color: var(--text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    min-height: 48px;
  }
  
  .form-input::placeholder {
    color: var(--text-dim);
  }
  
  .form-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }
  
  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }
  
  .submit-btn {
    background-color: var(--accent);
    color: black;
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.875rem 1.5rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    min-height: 48px;
  }
  
  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--accent-glow);
  }
  
  .submit-btn:active {
    transform: scale(0.97);
  }
  
  .form-success {
    display: none;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background-color: rgba(74, 222, 128, 0.1);
    border: 1px solid var(--success);
    border-radius: 8px;
    color: var(--success);
  }
  
  .form-success.show {
    display: flex;
  }
  
  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form');
  const success = document.getElementById('form-success');
  
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // TODO: Connect to Formspree or serverless function
      // For now, show success message
      if (success) {
        success.classList.add('show');
        (form as HTMLFormElement).reset();
        
        setTimeout(() => {
          success.classList.remove('show');
        }, 5000);
      }
    });
  }
</script>