---
import Button from '../ui/Button.astro';
---

<section class="hero">
  <video class="hero-video" autoplay loop muted playsinline id="hero-video">
    <source src="/hero-video.mp4" type="video/mp4">
  </video>
  <div class="hero-overlay"></div>
  <div class="hero-glow"></div>
  
  <div class="hero-content container">
    <span class="eyebrow">COVINGTON, KY · SE HABLA ESPAÑOL</span>
    
    <h1 class="headline">
      <span class="word">Honest</span>
      <span class="word">auto</span>
      <span class="word">repair.</span>
    </h1>
    
    <p class="subhead">No upsells. No BS. Family-owned shop in Covington serving Northern Kentucky and Cincinnati for brakes, suspension, engine work, and performance.</p>
    
    <div class="cta-group">
      <Button href="tel:18594147088" variant="primary" magnetic={true}>
        Call (859) 414-7088
      </Button>
      <Button href="https://maps.google.com/?q=501+Highland+Pike+Covington+KY+41014" variant="secondary" target="_blank">
        Get Directions
      </Button>
    </div>
    
    <div class="trust-pill">
      <span class="stars">★ 4.7</span>
      <span class="separator">·</span>
      <span class="reviews">37+ reviews</span>
      <span class="separator">·</span>
      <span class="hours">Open until 6 PM</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 80px;
    overflow: hidden;
  }
  
  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -2;
  }
  
  @media (max-width: 768px) {
    .hero-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
  
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(10, 10, 11, 0.7) 0%, rgba(10, 10, 11, 0.85) 100%);
    z-index: -1;
  }
  
  .hero-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 400px;
    background: radial-gradient(ellipse 800px 400px at 50% 0%, rgba(255, 87, 34, 0.05) 0%, transparent 70%);
    pointer-events: none;
  }
  
  .hero-content {
    position: relative;
    max-width: 800px;
  }
  
  .eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    animation: fadeIn 0.4s ease 0.2s both;
  }
  
  .headline {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin-bottom: 1.5rem;
  }
  
  .word {
    display: inline-block;
    animation: wordReveal 0.6s ease forwards;
    opacity: 0;
  }
  
  .word:nth-child(1) { animation-delay: 0.3s; }
  .word:nth-child(2) { animation-delay: 0.35s; }
  .word:nth-child(3) { animation-delay: 0.4s; }
  
  @keyframes wordReveal {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .subhead {
    font-size: 1.125rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 600px;
    margin-bottom: 2rem;
    animation: slideUp 0.5s ease 0.7s both;
  }
  
  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
    animation: slideUp 0.5s ease 0.9s both;
  }
  
  .cta-group > :first-child {
    animation: slideUp 0.5s ease 0.9s both;
  }
  
  .cta-group > :last-child {
    animation: slideUp 0.5s ease 0.98s both;
  }
  
  .trust-pill {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    animation: fadeIn 0.4s ease 1.1s both;
  }
  
  .stars {
    color: var(--accent);
    font-weight: 600;
  }
  
  .separator {
    color: var(--text-dim);
  }
  
  @media (max-width: 768px) {
    .cta-group {
      flex-direction: column;
    }
    
    .cta-group a {
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  const video = document.getElementById('hero-video');
  if (video) {
    video.play().catch(() => {
      window.addEventListener('load', () => video.play().catch(() => {}));
    });
  }
</script>