---
const reviews = [
  {
    quote: "JT and the crew always take care of me — everyone.",
    name: "Steven Swartz",
    stars: 5,
  },
  {
    quote: "Very good mechanic and they don't try to upsell like most places. Honest and very reasonable on their prices.",
    name: "Chad Roedersheimer",
    stars: 5,
  },
  {
    quote: "Family-owned business that treats business partners like family. Took care of the brakes and now I feel safe for my daughter to drive anywhere.",
    name: "Kevin Laudat",
    stars: 5,
  },
  {
    quote: "Truly the best experience I've ever had at an auto shop. Kelly and her husband are the best.",
    name: "David Hall",
    stars: 5,
  },
  {
    quote: "Great service, great prices, very punctual. They work on foreigns too — I have a newer BMW and they took care of it no problem.",
    name: "Rico L",
    stars: 5,
  },
];
---

<section id="reviews" class="reviews section-padding">
  <div class="container">
    <span class="eyebrow">WHAT CUSTOMERS SAY</span>
    <h2 class="headline">4.7 stars on Google. 37 reviews and counting.</h2>
    
    <div class="reviews-scroller">
      {reviews.map((review, index) => (
        <article class="review-card" style={`animation-delay: ${index * 80}ms`}>
          <div class="stars">
            {Array.from({ length: review.stars }, (_, i) => (
              <span class="star">★</span>
            ))}
          </div>
          <blockquote class="quote">"{review.quote}"</blockquote>
          <div class="reviewer">
            <span class="name">— {review.name}</span>
            <span class="verified">Verified Google Review</span>
          </div>
        </article>
      ))}
    </div>
    
    <a 
      href="https://www.google.com/maps/place/Dream+Performance+Vehicle+Repair/@39.0837,-84.5086,15z/data=!4m8!3m7!1s0x8841b5c8b3b3b3b3:0x1234567890abcdef!8m2!3d39.0837!4d-84.5086!9m1!1b1" 
      target="_blank" 
      rel="noopener noreferrer"
      class="all-reviews-link"
    >
      Read all 37 reviews on Google →
    </a>
  </div>
</section>

<style>
  .reviews {
    background-color: var(--bg);
  }
  
  .eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  
  .headline {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 3rem;
  }
  
  .reviews-scroller {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
  }
  
  .reviews-scroller::-webkit-scrollbar {
    display: none;
  }
  
  .review-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    min-width: 280px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  
  .review-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-4px);
  }
  
  .stars {
    display: flex;
    gap: 0.125rem;
  }
  
  .star {
    color: var(--accent);
    font-size: 1rem;
  }
  
  .quote {
    font-size: 0.9375rem;
    color: var(--text);
    line-height: 1.6;
    font-style: normal;
  }
  
  .reviewer {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: auto;
  }
  
  .name {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  
  .verified {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  
  .all-reviews-link {
    display: inline-block;
    color: var(--accent);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .all-reviews-link:hover {
    color: var(--accent-hover);
  }
  
  @media (max-width: 1200px) {
    .reviews-scroller {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .reviews-scroller {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .review-card {
      min-width: 260px;
    }
  }
  
  @media (max-width: 500px) {
    .reviews-scroller {
      grid-template-columns: 1fr;
    }
    
    .review-card {
      min-width: 100%;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const cards = entry.target.querySelectorAll('.review-card');
        cards.forEach((card, index) => {
          setTimeout(() => {
            (card as HTMLElement).style.opacity = '1';
            (card as HTMLElement).style.transform = 'translateY(0)';
          }, index * 80);
        });
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reviews-scroller').forEach(el => {
    const cards = el.querySelectorAll('.review-card');
    cards.forEach((card) => {
      (card as HTMLElement).style.opacity = '0';
      (card as HTMLElement).style.transform = 'translateY(20px)';
      (card as HTMLElement).style.transition = 'opacity 0.5s ease, transform 0.5s ease';
    });
    observer.observe(el);
  });

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReducedMotion) {
    document.querySelectorAll('.review-card').forEach(el => {
      (el as HTMLElement).style.opacity = '1';
      (el as HTMLElement).style.transform = 'none';
    });
  }
</script>