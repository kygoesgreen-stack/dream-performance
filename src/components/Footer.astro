---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <span class="footer-logo">DREAM PERFORMANCE</span>
        <p class="footer-address">
          501 Highland Pike<br>
          Covington, KY 41014
        </p>
        <a href="tel:18594147088" class="footer-phone">(859) 414-7088</a>
        <!-- TODO: Add founding year -->
        <p class="footer-note">Family-owned since [YEAR TBD]</p>
      </div>
      
      <div class="footer-col">
        <h4 class="footer-heading">Quick Links</h4>
        <nav class="footer-nav">
          <a href="#services" class="footer-link">Services</a>
          <a href="#reviews" class="footer-link">Reviews</a>
          <a href="#location" class="footer-link">Location</a>
        </nav>
      </div>
      
      <div class="footer-col">
        <h4 class="footer-heading">Hours</h4>
        <div class="footer-hours">
          <p>Mon–Fri: 8 AM – 6 PM</p>
          <p>Sat: By appointment</p>
        </div>
        <a 
          href="https://www.facebook.com/DreamPerformance21/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="social-icon"
          aria-label="Facebook"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.77,7.46H14.5v-1.9c0-.9.6-1.1,1-1.1h3V.5h-4.33C10.24.5,9.5,3.44,9.5,5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4Z"/>
          </svg>
        </a>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>© {currentYear} Dream Performance Vehicle Repair · Covington, KY</p>
      <!-- TODO: Add site attribution -->
      <p>Site by [TODO]</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--bg-elevated);
    border-top: 1px solid var(--border);
    padding: 4rem 0 2rem;
  }
  
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }
  
  .footer-logo {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    display: block;
    margin-bottom: 1rem;
  }
  
  .footer-address {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  
  .footer-phone {
    font-size: 0.9375rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  
  .footer-phone:hover {
    text-decoration: underline;
  }
  
  .footer-note {
    font-size: 0.8125rem;
    color: var(--text-dim);
    margin-top: 1rem;
  }
  
  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-dim);
    margin-bottom: 1rem;
  }
  
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .footer-link {
    font-size: 0.9375rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .footer-link:hover {
    color: var(--text);
  }
  
  .footer-hours {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.8;
  }
  
  .social-icon {
    display: inline-flex;
    color: var(--text-muted);
    margin-top: 1rem;
    transition: color 0.2s ease;
  }
  
  .social-icon:hover {
    color: var(--accent);
  }
  
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--text-dim);
  }
  
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>