  Call Now
</a>

<style>
  .sticky-call {
    display: none;
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 90;
    background-color: var(--accent);
    color: black;
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    text-decoration: none;
    gap: 0.5rem;
    align-items: center;
    box-shadow: 0 8px 24px var(--accent-glow);
    transform: translateY(100px);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  
  .sticky-call.visible {
    display: flex;
    transform: translateY(0);
    opacity: 1;
  }
  
  @media (max-width: 768px) {
    .sticky-call {
      display: flex;
    }
    
    .sticky-call.hidden {
      transform: translateY(100px);
      opacity: 0;
    }
  }
</style>

<script>
  const stickyCall = document.getElementById('sticky-call');
  const heroHeight = 500;
  let lastScrollY = 0;
  let ticking = false;
  
  function updateStickyCall() {
    const scrollY = window.scrollY;
    const windowHeight = window.innerHeight;
    const docHeight = document.documentElement.scrollHeight;
    
    const isPastHero = scrollY > heroHeight;
    const isNearBottom = scrollY + windowHeight > docHeight - 100;
    
    if (isPastHero && !isNearBottom) {
      stickyCall?.classList.add('visible');
      stickyCall?.classList.remove('hidden');
    } else {
      stickyCall?.classList.add('hidden');
      stickyCall?.classList.remove('visible');
    }
    
    ticking = false;
  }
  
  window.addEventListener('scroll', () => {
    lastScrollY = window.scrollY;
    if (!ticking) {
      window.requestAnimationFrame(updateStickyCall);
      ticking = true;
    }
  }, { passive: true });
  
  updateStickyCall();
</script>