---
interface Props {
  class?: string;
  hoverable?: boolean;
}

const { class: className = '', hoverable = false } = Astro.props;
---

<div 
  class:list={[
    "bg-[var(--bg-card)] border border-[var(--border)] rounded-xl p-6",
    hoverable && "service-card",
    className
  ]}
>
  <slot />
</div>

<style>
  .service-card {
    transition: transform 0.25s ease-out, border-color 0.25s ease-out, box-shadow 0.25s ease-out;
  }
  
  .service-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-hover);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4), 0 0 0 1px var(--border-hover) inset;
  }
  
  .service-card:hover :global(.card-icon) {
    transform: scale(1.1);
    color: var(--accent);
  }
</style>