---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
  magnetic?: boolean;
}

const { 
  href, 
  variant = 'primary', 
  class: className = '',
  magnetic = false
} = Astro.props;

const baseStyles = `
  inline-flex items-center justify-center gap-2
  font-semibold text-[0.9375rem] py-[0.875rem] px-[1.5rem]
  rounded-lg transition-all duration-200
  min-h-[48px] min-w-[48px]
  focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg)]
  cursor-pointer select-none
`;

const primaryStyles = `
  bg-[var(--accent)] text-black
  hover:translate-y-[-2px] hover:shadow-[0_8px_24px_var(--accent-glow)]
  active:scale-[0.97]
  ease-[cubic-bezier(0.34,1.56,0.64,1)]
`;

const secondaryStyles = `
  bg-transparent border border-[var(--border)]
  text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)]
`;

const Tag = href ? 'a' : 'button';
---

<Tag 
  href={href}
  class:list={[baseStyles, variant === 'primary' ? primaryStyles : secondaryStyles, className]}
  data-magnetic={magnetic}
>
  <slot />
</Tag>

<script>
  document.querySelectorAll('[data-magnetic="true"]').forEach(button => {
    if ('ontouchstart' in window) return;
    
    const el = button as HTMLElement;
    
    const handleMove = (e: MouseEvent) => {
      const rect = el.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      
      const distance = Math.sqrt(x * x + y * y);
      const maxDistance = 40;
      
      if (distance < maxDistance) {
        const moveX = (x / maxDistance) * 6;
        const moveY = (y / maxDistance) * 6;
        el.style.transform = `translate(${moveX}px, ${moveY}px)`;
      }
    };
    
    const handleLeave = () => {
      el.style.transform = 'translate(0, 0)';
    };
    
    el.addEventListener('mousemove', handleMove);
    el.addEventListener('mouseleave', handleLeave);
  });
</script>